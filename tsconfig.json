{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@aura/domain-catalog": ["./packages/domain/catalog/index.ts"],
      "@aura/domain-catalog/*": ["./packages/domain/catalog/*"],
      "@aura/domain-customer": ["./packages/domain/customer/index.ts"],
      "@aura/domain-customer/*": ["./packages/domain/customer/*"],
      "@aura/domain-crm": ["./packages/domain/crm/index.ts"],
      "@aura/domain-crm/*": ["./packages/domain/crm/*"],
      "@aura/domain-order": ["./packages/domain/order/index.ts"],
      "@aura/domain-order/*": ["./packages/domain/order/*"],
      "@aura/domain-table": ["./packages/domain/table/index.ts"],
      "@aura/domain-table/*": ["./packages/domain/table/*"],
      "@aura/domain-payment": ["./packages/domain/payment/index.ts"],
      "@aura/domain-payment/*": ["./packages/domain/payment/*"],
      "@aura/domain-kitchen": ["./packages/domain/kitchen/index.ts"],
      "@aura/domain-kitchen/*": ["./packages/domain/kitchen/*"],
      "@aura/domain-staff": ["./packages/domain/staff/index.ts"],
      "@aura/domain-staff/*": ["./packages/domain/staff/*"],
      "@aura/domain-shift": ["./packages/domain/shift/index.ts"],
      "@aura/domain-shift/*": ["./packages/domain/shift/*"],
      "worker/*": ["./worker/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "worker"]
}
