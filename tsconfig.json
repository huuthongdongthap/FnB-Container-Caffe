{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@aura/domain-customer": ["./packages/domain/customer/index.ts"],
      "@aura/domain-customer/*": ["./packages/domain/customer/*"],
      "@aura/domain-crm": ["./packages/domain/crm/index.ts"],
      "@aura/domain-crm/*": ["./packages/domain/crm/*"],
      "@aura/domain-order": ["./packages/domain/order/index.ts"],
      "@aura/domain-order/*": ["./packages/domain/order/*"],
      "worker/*": ["./worker/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "worker"]
}
