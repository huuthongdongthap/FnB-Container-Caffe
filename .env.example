# Payment Gateway Credentials
# Replace with your actual credentials in production

# VNPay (Sandbox)
VNPAY_TMN_CODE=TEST
VNPAY_HASH_SECRET=your_vnpay_hash_secret_here

# MoMo (Sandbox)
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your_momo_access_key_here
MOMO_SECRET_KEY=your_momo_secret_key_here

# PayOS
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# Email (SendGrid — transactional)
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=aura@fnb-caffe-container.pages.dev
EMAIL_FROM_NAME=AURA CAFE

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Analytics (Vite — frontend)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_FB_PIXEL_ID=1234567890

# API Base URL (Vite — frontend)
# Default: https://aura-space-worker.agencyos-openclaw.workers.dev
# VITE_API_BASE=https://your-worker.example.com
