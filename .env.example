# Payment Gateway Credentials
# Replace with your actual credentials in production

# ERPNext Integration
# Get from: ERPNext → Settings → API Access
# Leave empty to use mock client (logs shape for later replay)
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_SYNC_ENABLED=false

# PayOS
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# Email (SendGrid — transactional)
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=aura@fnb-caffe-container.pages.dev
EMAIL_FROM_NAME=AURA CAFE

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Analytics (Vite — frontend)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_FB_PIXEL_ID=1234567890

# API Base URL (Vite — frontend)
# Default: https://aura-space-worker.sadec-marketing-hub.workers.dev
# Production builds must set this in .env.production (gitignored) — .env.local
# overrides .env.[mode] in Vite, so a dev .env.local with localhost leaks into
# production builds unless .env.production pins the public URL.
# VITE_API_BASE=https://your-worker.example.com
